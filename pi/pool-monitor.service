[Unit]
Description=Pool temperature logger and web page
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
# Edit this path if the repo is cloned somewhere else
WorkingDirectory=/home/pi/ESP32-C3-Pool-Temperature-Monitor/pi
EnvironmentFile=/etc/pool-monitor.env
# Lets the service (running as pi, not root) listen on port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

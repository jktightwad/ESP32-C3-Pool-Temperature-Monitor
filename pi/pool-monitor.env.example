# Copy to /etc/pool-monitor.env and fill in (see docs/PI_SETUP.md).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=pool
MQTT_PASSWORD=your-mqtt-password
MQTT_TOPIC=pool/temp
# 8080 is used by the Orbi dashboard on piserver; port 80 is left free for
# other services (or a future reverse proxy).
WEB_PORT=8090
# Show a warning when the newest reading is older than this.
STALE_MINUTES=30
# Database location (default: pool.db next to app.py)
#DB_PATH=/home/pi/pool.db
# Reporting schedule sent to the ESP32 (local time on the Pi). Readings every
# DAY_INTERVAL_S seconds between DAY_START and DAY_END, NIGHT_INTERVAL_S
# otherwise. The ESP32 accepts 15-3600 s. Keep STALE_MINUTES above the night
# interval.
DAY_START=08:00
DAY_END=19:00
DAY_INTERVAL_S=60
NIGHT_INTERVAL_S=600

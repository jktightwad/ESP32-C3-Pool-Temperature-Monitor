# Copy to /etc/pool-monitor.env and fill in (see docs/PI_SETUP.md).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=pool
MQTT_PASSWORD=your-mqtt-password
MQTT_TOPIC=pool/temp
# 8080 is used by the Orbi dashboard on piserver; port 80 is left free for
# other services (or a future reverse proxy).
WEB_PORT=8090
# Show a warning when the newest reading is older than this.
STALE_MINUTES=30
# Database location (default: pool.db next to app.py)
#DB_PATH=/home/pi/pool.db
